# Copy to .env.local and fill in. Add the same values in Vercel project settings.

# Supabase (Project Settings, API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the Atelier and the Notion sync to bypass row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# Notion (notion.so/my-integrations). WORKLOG_DB is the work-log database id.
NOTION_TOKEN=
NOTION_WORKLOG_DB=

# Where magic links and invites come back to. Local: http://localhost:3000
# Production: your Vercel URL. Must also be listed in Supabase > Authentication > URL Configuration.
NEXT_PUBLIC_SITE_URL=

NOTION_PROJECTS_DB=3a7fd641-0792-8192-b9f7-ccd898e5e915
NOTION_CLIENTS_DB=3a7fd641-0792-81d0-ad5c-f733d480b28f

# Any long random string. Lets a scheduled job call /api/notion-sync without a session.
CRON_SECRET=
